# Copy to .env and fill in. Never commit .env.

# Comma-separated OAuth client ID(s) of the Apps Script project (the "aud" of its identity tokens).
# Find it by running debugIdentityToken() in the Apps Script editor.
ALLOWED_AUDIENCES=

# Who may use the add-on: "*" (any verified Google account), "*@example.com" (one domain),
# or a comma-separated list of accounts. Tokens must still be issued to ALLOWED_AUDIENCES.
ALLOWED_EMAILS=

# Public hostname for HTTPS. Without your own domain, use <public-ip-with-dashes>.sslip.io
DOMAIN=

LOG_LEVEL=INFO

# VirusTotal API key for the virustotal_domain rule (free account: profile -> API key).
# Without it the service still runs; that rule is listed in rulesFailed. scripts/deploy.sh copies
# it from ~/.vt_api_key.txt. This is the only secret: never commit it, never paste it in chat.
VT_API_KEY=

# Production: read the VirusTotal key from AWS Secrets Manager with the instance's IAM role
# (secretsmanager:GetSecretValue on this ARN). Not secret. When set, VT_API_KEY is not needed.
VT_API_KEY_SECRET_ARN=
# Field holding the key in a key/value secret (a plaintext secret is used as is).
VT_API_KEY_SECRET_FIELD=VT_API_KEY
